{
    "name": "moe/laravel-notify",
    "description": "MOE multi-channel notification package for Laravel — email, SMS, WhatsApp, in-app, push.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "notification",
        "email",
        "sms",
        "whatsapp",
        "push",
        "in-app",
        "moe"
    ],
    "authors": [
        {
            "name": "MindOfEmanizer",
            "email": "mindofemanizer@users.noreply.github.com"
        }
    ],
    "support": {
        "issues": "https://github.com/mindofemanizer/MOE-Laravel-Notify/issues",
        "source": "https://github.com/mindofemanizer/MOE-Laravel-Notify"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11 | ^12 | ^13",
        "illuminate/notifications": "^11 | ^12 | ^13",
        "illuminate/database": "^11 | ^12 | ^13",
        "illuminate/queue": "^11 | ^12 | ^13",
        "illuminate/mail": "^11 | ^12 | ^13"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "orchestra/testbench": "^8 | ^9 | ^10",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Moe\\Notify\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Moe\\Notify\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Moe\\Notify\\NotifyServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
